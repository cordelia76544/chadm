{ config, lib, pkgs, ... }:
let
  cfg = config.virtualisation.chadm;
  inherit (lib) mkOption types;
  absolutePath = types.strMatching "/[A-Za-z0-9_./-]+";
  safePath = path: path != "/" && !(lib.elem ".." (lib.splitString "/" path))
    && !(lib.elem "." (lib.splitString "/" path)) && !(lib.hasSuffix "/" path)
    && !(lib.hasInfix "//" path);
  repos = lib.mapAttrsToList (name: repo: repo // { inherit name; }) cfg.repos;
  hasZfs = lib.any (repo: repo.driver == "zfs") repos;
  fetchedFirmware = pkgs.fetchurl {
    url = "https://github.com/${cfg.firmware.github.owner}/${cfg.firmware.github.repo}/releases/download/${cfg.firmware.github.rev}/${cfg.firmware.github.asset}";
    hash = cfg.firmware.github.hash;
  };
  firmwareSource = if cfg.firmware.source != null then cfg.firmware.source else fetchedFirmware;
  manifest = pkgs.writeText "chadm-host-settings.json" (builtins.toJSON {
    inherit (cfg) dataDir runtimeDir manageHostConfig defaultBridge;
    inherit repos;
    chadm = "${cfg.package}/bin/chadm";
    systemctl = "${config.systemd.package}/bin/systemctl";
    firmware = if cfg.firmware.enable then "${firmwareSource}" else null;
  });
in {
  options.virtualisation.chadm = {
    enable = lib.mkEnableOption "chadm and its shared Cloud Hypervisor systemd template";
    package = mkOption {
      type = types.package;
      default = pkgs.callPackage ./package.nix {
        cloud-hypervisor = cfg.cloudHypervisorPackage;
        withZfs = cfg.enableZfs;
        zfs = if cfg.enableZfs then config.boot.zfs.package else null;
      };
      description = "chadm package, including its matching unmodified shared template.";
    };
    cloudHypervisorPackage = mkOption {
      type = types.package;
      default = pkgs.cloud-hypervisor;
      description = "Cloud Hypervisor build included in chadm's fixed tool search path.";
    };
    enableZfs = mkOption {
      type = types.bool;
      default = hasZfs;
      description = "Include the host's ZFS userspace tools; defaults to true when a ZFS repo is declared. Configure pool import and kernel support separately.";
    };
    dataDir = mkOption {
      type = absolutePath;
      default = "/var/lib/chadm";
      description = "Mutable host metadata and fixed CLOUDHV.fd directory; changing this never migrates existing resources.";
    };
    runtimeDir = mkOption {
      type = absolutePath;
      default = "/run/chadm";
      description = "Runtime sockets and ownership records; must be under /run.";
    };
    defaultBridge = mkOption {
      type = types.nullOr (types.strMatching "[A-Za-z0-9_.-]{1,15}");
      default = null;
      description = "Existing Linux bridge used when instance create omits --net or --net omits bridge=. Validated at instance creation; does not create the bridge or configure DHCP.";
    };
    manageHostConfig = mkOption {
      type = types.bool;
      default = true;
      description = "Maintain /etc/chadm/config.toml as a regular file. If false, initialize it only when absent and require existing directory settings to agree. VM configurations are never generated by Nix.";
    };
    repos = mkOption {
      default = { };
      description = "Host storage repositories to ensure exist. Removing or changing a declaration never deletes or migrates storage; mismatches fail setup.";
      type = types.attrsOf (types.submodule {
        options = {
          driver = mkOption { type = types.enum [ "file" "zfs" ]; default = "file"; };
          path = mkOption {
            type = types.nullOr absolutePath;
            default = null;
            description = "File repo directory; required only for driver=file. The name cloudinit is supported for raw seed storage.";
          };
          pool = mkOption {
            type = types.nullOr (types.strMatching "[A-Za-z][A-Za-z0-9_.:-]*(/[A-Za-z0-9_][A-Za-z0-9_.:-]*)+");
            default = null;
            description = "New chadm-owned dataset below an imported pool, e.g. tank/chadm. Do not pre-create this dataset.";
          };
        };
      });
    };
    firmware = {
      enable = lib.mkEnableOption "installing pinned UEFI firmware as a regular CLOUDHV.fd file";
      source = mkOption {
        type = types.nullOr (types.either types.path types.package);
        default = null;
        description = "Local firmware file or a fetchurl derivation; overrides the GitHub release settings.";
      };
      github = {
        owner = mkOption { type = types.strMatching "[A-Za-z0-9_-]+"; default = "cloud-hypervisor"; };
        repo = mkOption { type = types.strMatching "[A-Za-z0-9_.-]+"; default = "edk2"; };
        rev = mkOption {
          type = types.str;
          default = "";
          description = "Pinned GitHub release tag, required when downloading firmware. Mutable latest is rejected.";
        };
        hash = mkOption {
          type = types.str;
          default = "";
          description = "SHA-256 SRI hash of the release asset, required for a GitHub download.";
        };
        asset = mkOption {
          type = types.strMatching "[A-Za-z0-9_][A-Za-z0-9_.-]+";
          default = if pkgs.stdenv.hostPlatform.isAarch64 then "CLOUDHV_EFI.fd" else "CLOUDHV.fd";
          description = "Release asset filename; installed locally under the fixed name CLOUDHV.fd.";
        };
      };
    };
  };
  config = lib.mkIf cfg.enable {
    assertions = [
      { assertion = safePath cfg.dataDir && safePath cfg.runtimeDir
          && lib.hasPrefix "/run/" cfg.runtimeDir
          && !(lib.hasPrefix "${cfg.dataDir}/" cfg.runtimeDir)
          && !(lib.hasPrefix "${cfg.runtimeDir}/" cfg.dataDir) && cfg.dataDir != cfg.runtimeDir;
        message = "chadm: use canonical nonoverlapping dataDir/runtimeDir paths; runtimeDir must be below /run."; }
      { assertion = !hasZfs || cfg.enableZfs; message = "chadm: ZFS repositories require enableZfs."; }
      { assertion = !cfg.firmware.enable || cfg.firmware.source != null || (
          builtins.match "[A-Za-z0-9_][A-Za-z0-9_.+-]*" cfg.firmware.github.rev != null
          && cfg.firmware.github.rev != "latest"
          && builtins.match "sha256-[A-Za-z0-9+/]{43}=" cfg.firmware.github.hash != null);
        message = "chadm: firmware requires a local source or a pinned GitHub release tag and SHA-256 SRI hash."; }
    ] ++ lib.mapAttrsToList (name: repo: {
      assertion = builtins.match "[a-z][a-z0-9-]{0,62}" name != null
        && (if repo.driver == "file" then repo.path != null && repo.pool == null && safePath repo.path
            else repo.pool != null && repo.path == null && name != "cloudinit");
      message = "chadm: invalid repository ${name}; file needs path, ZFS needs pool; cloudinit is file-only.";
    }) cfg.repos;
    environment.systemPackages = [ cfg.package ];
    systemd.packages = [ cfg.package ];
    boot.kernelModules = [ "tun" ];
    systemd.tmpfiles.rules = [
      "d ${cfg.dataDir} 0700 root root -"
      "d ${cfg.runtimeDir} 0700 root root -"
    ];
    systemd.services.chadm-host-setup = {
      description = "Ensure chadm host configuration, firmware and storage repositories";
      wantedBy = [ "multi-user.target" ];
      after = [ "local-fs.target" "systemd-tmpfiles-setup.service" ]
        ++ lib.optional cfg.enableZfs "zfs-import.target";
      unitConfig.RequiresMountsFor = [ cfg.dataDir ]
        ++ map (repo: repo.path) (lib.filter (repo: repo.driver == "file") repos);
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        UMask = "0077";
        ExecStart = "${pkgs.python3}/bin/python3 ${./host-setup.py} ${manifest}";
        TimeoutStartSec = 300;
      };
      restartTriggers = [ manifest ];
    };
  };
}
